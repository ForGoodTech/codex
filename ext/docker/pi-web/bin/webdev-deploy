#!/usr/bin/env bash

# Atomic SSH/rsync deployment for verified webdev release directories.
# Credentials are supplied by mounted files; secret values are never accepted
# as command-line arguments or printed.

set -Eeuo pipefail

fail() {
  printf '%s\n' "webdev-deploy: $*" >&2
  exit 1
}

release_dir=${1:-}
[[ -n "$release_dir" ]] || fail "usage: webdev-deploy <verified-release-directory>"
[[ -d "$release_dir" ]] || fail "release directory does not exist: $release_dir"
[[ ! -L "$release_dir" ]] || fail "release directory cannot be a symbolic link"
[[ -s "$release_dir/index.php" || -s "$release_dir/index.html" ]] || \
  fail "release directory has no non-empty index.php or index.html: $release_dir"

deploy_host=${SURESTINFO_DEPLOY_HOST:-}
deploy_user=${SURESTINFO_DEPLOY_USER:-}
deploy_port=${SURESTINFO_DEPLOY_PORT:-22}
deploy_root=${SURESTINFO_DEPLOY_ROOT:-}
identity_file=${SURESTINFO_DEPLOY_IDENTITY_FILE:-}
known_hosts_file=${SURESTINFO_DEPLOY_KNOWN_HOSTS_FILE:-}
health_url=${SURESTINFO_DEPLOY_HEALTH_URL:-}
health_timeout=${SURESTINFO_DEPLOY_HEALTH_TIMEOUT_SEC:-30}
skip_healthcheck=${SURESTINFO_DEPLOY_SKIP_HEALTHCHECK:-0}
dry_run=${SURESTINFO_DEPLOY_DRY_RUN:-0}

[[ "$deploy_host" =~ ^[A-Za-z0-9._:-]+$ ]] || fail "SURESTINFO_DEPLOY_HOST is required and contains unsupported characters"
[[ "$deploy_user" =~ ^[A-Za-z_][A-Za-z0-9._-]*$ ]] || fail "SURESTINFO_DEPLOY_USER is required and invalid"
[[ "$deploy_port" =~ ^[0-9]+$ ]] && (( deploy_port >= 1 && deploy_port <= 65535 )) || fail "SURESTINFO_DEPLOY_PORT must be between 1 and 65535"
[[ "$deploy_root" =~ ^/[A-Za-z0-9._/-]+$ ]] || fail "SURESTINFO_DEPLOY_ROOT must be an absolute path without spaces"
[[ "/$deploy_root/" != *"/../"* && "/$deploy_root/" != *"/./"* && "$deploy_root" != *"//"* ]] || fail "SURESTINFO_DEPLOY_ROOT must be a normalized absolute path"
[[ "$deploy_root" != "/" && "$deploy_root" != "/home" && "$deploy_root" != "/var" && "$deploy_root" != "/srv" ]] || fail "SURESTINFO_DEPLOY_ROOT is too broad"
[[ "$health_timeout" =~ ^[0-9]+$ ]] && (( health_timeout >= 1 && health_timeout <= 600 )) || fail "SURESTINFO_DEPLOY_HEALTH_TIMEOUT_SEC must be between 1 and 600"
[[ "$skip_healthcheck" == "0" || "$skip_healthcheck" == "1" ]] || fail "SURESTINFO_DEPLOY_SKIP_HEALTHCHECK must be 0 or 1"
[[ "$dry_run" == "0" || "$dry_run" == "1" ]] || fail "SURESTINFO_DEPLOY_DRY_RUN must be 0 or 1"
[[ -r "$identity_file" ]] || fail "SURESTINFO_DEPLOY_IDENTITY_FILE must name a readable private-key file"
[[ -r "$known_hosts_file" ]] || fail "SURESTINFO_DEPLOY_KNOWN_HOSTS_FILE must name a readable pinned known_hosts file"
if [[ -z "$health_url" && "$skip_healthcheck" != "1" ]]; then
  fail "SURESTINFO_DEPLOY_HEALTH_URL is required unless SURESTINFO_DEPLOY_SKIP_HEALTHCHECK=1"
fi
if [[ -n "$health_url" && ! "$health_url" =~ ^https:// ]]; then
  fail "SURESTINFO_DEPLOY_HEALTH_URL must use https://"
fi

for command_name in ssh rsync sha256sum find sort xargs date curl stat; do
  command -v "$command_name" >/dev/null 2>&1 || fail "missing required command: $command_name"
done

unexpected_release_path=$(find "$release_dir" -mindepth 1 ! -type f ! -type d -print -quit)
[[ -z "$unexpected_release_path" ]] || fail "release contains a symbolic link or special file: $unexpected_release_path"

identity_mode=$(stat -c '%a' "$identity_file")
[[ "$identity_mode" =~ ^[0-7]{3,4}$ ]] || fail "could not validate private-key permissions"
if (( (8#$identity_mode & 077) != 0 )); then
  fail "private-key permissions must deny group and other access"
fi

release_hash=$(
  cd "$release_dir"
  find . -type f -print0 \
    | sort -z \
    | xargs -0 sha256sum \
    | sha256sum \
    | awk '{print $1}'
)
release_id="$(date -u +%Y%m%dT%H%M%SZ)-${release_hash:0:12}"
remote="${deploy_user}@${deploy_host}"
incoming="$deploy_root/.incoming-$release_id"
release_target="$deploy_root/releases/$release_id"

ssh_args=(
  -p "$deploy_port"
  -i "$identity_file"
  -o BatchMode=yes
  -o IdentitiesOnly=yes
  -o StrictHostKeyChecking=yes
  -o "UserKnownHostsFile=$known_hosts_file"
)
rsync_ssh=$(printf ' %q' ssh "${ssh_args[@]}")
rsync_ssh=${rsync_ssh# }

if [[ "$dry_run" == "1" ]]; then
  printf 'webdev-deploy: verified release %s\n' "$release_id"
  printf 'webdev-deploy: dry run target %s:%s\n' "$remote" "$deploy_root"
  exit 0
fi

printf 'webdev-deploy: uploading release %s\n' "$release_id"
ssh "${ssh_args[@]}" "$remote" \
  "set -eu; mkdir -p '$deploy_root/releases'; rm -rf '$incoming'; mkdir -p '$incoming'"
rsync -az --delete --protect-args -e "$rsync_ssh" "$release_dir/" "$remote:$incoming/"

previous_target=$(
  ssh "${ssh_args[@]}" "$remote" \
    "set -eu; previous=''; if [ -L '$deploy_root/current' ]; then previous=\$(readlink '$deploy_root/current'); fi; if [ -d '$release_target' ]; then rm -rf '$incoming'; else mv '$incoming' '$release_target'; fi; ln -s 'releases/$release_id' '$deploy_root/.current-$release_id'; mv -Tf '$deploy_root/.current-$release_id' '$deploy_root/current'; printf '%s' \"\$previous\""
)

if [[ -n "$health_url" ]] && ! curl --fail --silent --show-error --location \
  --max-time "$health_timeout" "$health_url" >/dev/null
then
  printf '%s\n' "webdev-deploy: health check failed; rolling back" >&2
  if [[ -n "$previous_target" && "$previous_target" =~ ^releases/[A-Za-z0-9._-]+$ ]]; then
    ssh "${ssh_args[@]}" "$remote" \
      "set -eu; ln -s '$previous_target' '$deploy_root/.rollback-$release_id'; mv -Tf '$deploy_root/.rollback-$release_id' '$deploy_root/current'"
  else
    ssh "${ssh_args[@]}" "$remote" "rm -f '$deploy_root/current'"
  fi
  fail "deployment rolled back after the production health check failed"
fi

printf 'webdev-deploy: deployed release %s to %s\n' "$release_id" "$deploy_host"
